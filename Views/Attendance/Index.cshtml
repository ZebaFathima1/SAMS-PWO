@model IEnumerable<Attendance>
@{ViewData["Title"]="Attendance";}<div class="panel"><div class="d-flex justify-content-between mb-4"><p class="text-muted">Monitor attendance and shortages.</p>@if(User.IsInRole("Admin")){<a class="btn btn-primary" asp-action="Create">+ Record attendance</a>}</div><div class="table-responsive"><table class="table"><thead><tr><th>Student</th><th>Subject</th><th>Attended</th><th>Conducted</th><th>Attendance</th><th>Status</th>@if(User.IsInRole("Admin")){<th>Actions</th>}</tr></thead><tbody>@foreach(var a in Model){<tr><td>@a.Student?.FullName</td><td>@a.Subject?.SubjectName</td><td>@a.AttendedClasses</td><td>@a.ConductedClasses</td><td><div class="progress"><div class="progress-bar" style="width:@a.AttendancePercentage%"></div></div><small>@a.AttendancePercentage%</small></td><td><span class="@(a.AttendancePercentage < 75 ? "badge bg-warning text-dark" : "badge-soft")">@(a.AttendancePercentage < 75 ? "Shortage" : "Good")</span></td>@if(User.IsInRole("Admin")){<td><a asp-action="Edit" asp-route-id="@a.Id">Edit</a> | <a asp-action="Delete" asp-route-id="@a.Id" class="text-danger">Delete</a></td>}</tr>}</tbody></table></div></div>
