@model IEnumerable<Student>
@{ViewData["Title"]="Reports";}<div class="panel"><div class="mb-4"><p class="text-muted">Academic summaries and exportable performance reports.</p></div><div class="table-responsive"><table class="table"><thead><tr><th>Student</th><th>Average marks</th><th>Attendance</th><th>Subjects</th><th>Report</th></tr></thead><tbody>@foreach(var s in Model){var average=s.Marks.Any()?s.Marks.Average(m=>(double)m.TotalMarks):0;var attendance=s.AttendanceRecords.Any()?s.AttendanceRecords.Average(a=>a.ConductedClasses==0?0:(double)a.AttendedClasses/a.ConductedClasses*100):0;<tr><td><strong>@s.FullName</strong><br/><small class="text-muted">@s.RollNumber</small></td><td>@average.ToString("0.0") / 100</td><td><span class="@(attendance < 75 ? "badge bg-warning text-dark" : "badge-soft")">@attendance.ToString("0.0")%</span></td><td>@s.Marks.Select(m=>m.SubjectId).Distinct().Count()</td><td><a class="btn btn-sm btn-outline-primary" asp-action="Export" asp-route-id="@s.Id">Export TXT</a></td></tr>}</tbody></table></div></div>
