@model IEnumerable<Assignment>
@{ViewData["Title"]="Assignments";}<div class="panel"><div class="d-flex justify-content-between mb-4"><p class="text-muted">Plan and track academic work.</p>@if(User.IsInRole("Admin")){<a class="btn btn-primary" asp-action="Create">+ Add assignment</a>}</div><form class="input-group mb-3"><select name="status" class="form-select"><option value="">All statuses</option><option>Pending</option><option>Submitted</option><option>Completed</option></select><button class="btn btn-outline-primary">Filter</button></form><div class="table-responsive"><table class="table"><thead><tr><th>Assignment</th><th>Subject</th><th>Due date</th><th>Status</th>@if(User.IsInRole("Admin")){<th>Actions</th>}</tr></thead><tbody>@foreach(var a in Model){<tr><td><strong>@a.Title</strong><br/><small class="text-muted">@a.Description</small></td><td>@a.Subject?.SubjectName</td><td class="@(a.DueDate < DateTime.Today && a.Status != "Completed" ? "text-danger" : "")">@a.DueDate.ToString("dd MMM yyyy")</td><td><span class="badge-soft">@a.Status</span></td>@if(User.IsInRole("Admin")){<td><a asp-action="Edit" asp-route-id="@a.Id">Edit</a> | <a asp-action="Delete" asp-route-id="@a.Id" class="text-danger">Delete</a></td>}</tr>}</tbody></table></div></div>
