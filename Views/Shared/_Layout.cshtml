<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>@ViewData["Title"] - SAMS</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"/><link rel="stylesheet" href="~/css/site.css"/></head><body><div class="app-shell"><aside class="sidebar"><a class="brand" asp-controller="Home" asp-action="Index"><span>S</span><strong>SAMS</strong></a><small>SMARTER ACADEMIC MANAGEMENT</small><nav>@if(User.IsInRole("Admin")){<a asp-controller="Dashboard" asp-action="Index">◈ Dashboard</a><a asp-controller="Students" asp-action="Index">◉ Students</a><a asp-controller="Subjects" asp-action="Index">▦ Subjects</a><a asp-controller="Marks" asp-action="Index">▤ Marks</a><a asp-controller="Attendance" asp-action="Index">◒ Attendance</a><a asp-controller="Assignments" asp-action="Index">□ Assignments</a><a asp-controller="Reports" asp-action="Index">▣ Reports</a>}else if(User.IsInRole("Student")){<a asp-controller="StudentDashboard" asp-action="Index">◈ My dashboard</a><a asp-controller="Marks" asp-action="Index">▤ My marks</a><a asp-controller="Attendance" asp-action="Index">◒ My attendance</a><a asp-controller="Assignments" asp-action="Index">□ Assignments</a><a asp-controller="Reports" asp-action="Index">▣ My reports</a>}</nav><div class="sidebar-bottom"><a asp-controller="Account" asp-action="Logout">↪ Sign out</a></div></aside><main class="main-content"><header><div><span class="eyebrow">ACADEMIC OPERATIONS</span><h1>@ViewData["Title"]</h1></div><div class="user-chip"><span class="avatar">@(User.Identity?.Name?.Substring(0, 1).ToUpper() ?? "G")</span><span>@(User.Identity?.Name ?? "Guest")<small>@(User.IsInRole("Admin") ? "Administrator" : "Student")</small></span></div></header>@if (TempData["Message"] is not null){<div class="alert alert-success">@TempData["Message"]</div>}@RenderBody()</main></div>@await RenderSectionAsync("Scripts", required: false)</body></html>
