@{ViewData["Title"]="My academic overview"; var s=(Student)ViewBag.Student; var avg=s.Marks.Any()?s.Marks.Average(m=>m.TotalMarks):0; var attendance=s.AttendanceRecords.Any()?s.AttendanceRecords.Average(a=>(decimal)a.AttendancePercentage):0;}<div class="stat-grid"><div class="stat"><label>Welcome back</label><strong style="font-size:22px">@s.FullName</strong><small>@s.RollNumber</small></div><div class="stat"><label>Average marks</label><strong>@avg.ToString("0.0")</strong><small>Across @s.Marks.Count subjects</small></div><div class="stat"><label>Attendance</label><strong>@attendance.ToString("0.0")%</strong><small>@(attendance < 75 ? "Attendance shortage" : "Good standing")</small></div><div class="stat"><label>Pending work</label><strong>@ViewBag.Assignments.Count</strong><small>Assignments to complete</small></div></div>@if(attendance<75){<div class="alert alert-warning">Your attendance is below 75%. Please speak with your academic coordinator.</div>}<section class="panel"><h2>Subject performance</h2><table class="table"><thead><tr><th>Subject</th><th>Total marks</th><th>Grade</th><th>Attendance</th></tr></thead><tbody>@foreach(var m in s.Marks){var a=s.AttendanceRecords.FirstOrDefault(x=>x.SubjectId==m.SubjectId);<tr><td>@m.Subject?.SubjectName</td><td>@m.TotalMarks / 100</td><td><span class="badge-soft">@m.Grade</span></td><td>@(a?.AttendancePercentage ?? 0)%</td></tr>}</tbody></table></section>
