@{ Layout = null; }<!doctype html><html><head><meta name="viewport" content="width=device-width"/><title>Sign in - SAMS</title><link rel="stylesheet" href="~/css/site.css"/></head><body><div class="login-page"><section class="login-hero"><div class="brand"><span>S</span><strong>SAMS</strong></div><h1>Academic clarity,<br/>beautifully managed.</h1><p>One place to manage academic performance, attendance and student progress.</p></section><section class="login-card"><form class="login-box" method="post"><span class="eyebrow">WELCOME BACK</span><h2>Sign in to SAMS</h2><p class="text-muted">Manage academic performance with clarity.</p>@if(ViewBag.Error != null){<div class="alert alert-danger">@ViewBag.Error</div>}<div class="mb-3"><label class="form-label">Username</label><input name="username" class="form-control" required /></div><div class="mb-3"><label class="form-label">Password</label><input name="password" type="password" class="form-control" required /></div><div class="hint"><strong>Demo access</strong><br/>Admin: admin / Admin@123<br/>Student: student / Student@123</div><button class="btn btn-primary w-100 py-2">Continue to workspace</button></form></section></div></body></html>
