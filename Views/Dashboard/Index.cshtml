@{ViewData["Title"]="Dashboard";}<div class="stat-grid"><div class="stat"><label>Total students</label><strong>@ViewBag.Students</strong><small>Active records</small></div><div class="stat"><label>Average attendance</label><strong>@ViewBag.AverageAttendance.ToString("0.0")%</strong><small>Across all classes</small></div><div class="stat"><label>Average marks</label><strong>@ViewBag.AverageMarks.ToString("0.0")</strong><small>Out of 100</small></div><div class="stat"><label>Assignments</label><strong>@ViewBag.Assignments</strong><small>Tracked this term</small></div></div><div class="content-grid"><section class="panel"><h2>Recent students <a class="btn btn-sm btn-primary float-end" asp-controller="Students" asp-action="Create">+ Add student</a></h2><table class="table"><thead><tr><th>Student</th><th>Roll number</th><th>Department</th><th>Status</th></tr></thead><tbody>@foreach(var s in ViewBag.Recent){<tr><td><strong>@s.FullName</strong><br/><small class="text-muted">@s.Email</small></td><td>@s.RollNumber</td><td>@s.Department</td><td><span class="badge-soft">Active</span></td></tr>}</tbody></table></section><section class="panel"><h2>Attendance watchlist</h2><div class="p-3 bg-light rounded"><strong>@ViewBag.Warnings students</strong><p class="text-muted mb-0 mt-1">Need attention below the 75% threshold.</p></div><hr/><h2>Quick access</h2><a class="btn btn-outline-primary w-100" asp-controller="Students" asp-action="Index">Manage student records</a></section></div>
