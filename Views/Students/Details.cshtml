@model Student
@{ViewData["Title"]="Student profile";var attendance=Model.AttendanceRecords.Any()?Model.AttendanceRecords.Average(a=>a.ConductedClasses==0?0:(double)a.AttendedClasses/a.ConductedClasses*100):0;var marks=Model.Marks.Any()?Model.Marks.Average(m=>(double)m.TotalMarks):0;}<div class="stat-grid"><div class="stat"><label>Student</label><strong style="font-size:22px">@Model.FullName</strong><small>@Model.RollNumber</small></div><div class="stat"><label>Average marks</label><strong>@marks.ToString("0.0")</strong></div><div class="stat"><label>Attendance</label><strong>@attendance.ToString("0.0")%</strong></div><div class="stat"><label>Subjects</label><strong>@Model.Marks.Select(m=>m.SubjectId).Distinct().Count()</strong></div></div><section class="panel"><div class="d-flex justify-content-between"><h2>Academic performance</h2><a class="btn btn-outline-primary btn-sm" asp-controller="Reports" asp-action="Export" asp-route-id="@Model.Id">Export report</a></div><table class="table"><thead><tr><th>Subject</th><th>Marks</th><th>Grade</th><th>Attendance</th></tr></thead><tbody>@foreach(var m in Model.Marks){var a=Model.AttendanceRecords.FirstOrDefault(x=>x.SubjectId==m.SubjectId);<tr><td>@m.Subject?.SubjectName</td><td>@m.TotalMarks / 100</td><td><span class="badge-soft">@m.Grade</span></td><td>@(a?.AttendancePercentage ?? 0)%</td></tr>}</tbody></table></section>
