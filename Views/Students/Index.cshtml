@model IEnumerable<Student>
@{ViewData["Title"]="Students";}<div class="panel"><div class="d-flex justify-content-between align-items-center mb-4"><div><p class="text-muted mb-0">Manage student academic information</p></div><a class="btn btn-primary" asp-action="Create">+ Add student</a></div><form class="row g-2 mb-3"><div class="col-md-6"><input name="search" value="@ViewBag.Search" class="form-control" placeholder="Search name or roll number"/></div><div class="col-md-4"><select name="department" class="form-select"><option value="">All departments</option>@foreach(var d in ViewBag.Departments){<option>@d</option>}</select></div><div class="col-md-2"><button class="btn btn-outline-primary w-100">Filter</button></div></form><div class="table-responsive"><table class="table"><thead><tr><th>Student</th><th>Roll number</th><th>Department</th><th>Semester</th><th>Actions</th></tr></thead><tbody>@foreach(var s in Model){<tr><td><strong>@s.FullName</strong><br/><small class="text-muted">@s.Email</small></td><td>@s.RollNumber</td><td>@s.Department</td><td>@s.Semester</td><td><a asp-action="Details" asp-route-id="@s.Id" class="btn btn-sm btn-outline-primary">View</a> <a asp-action="Delete" asp-route-id="@s.Id" class="btn btn-sm btn-outline-danger">Delete</a></td></tr>}</tbody></table></div></div>
