@model Mark
<div class="row g-3 mb-4"><div class="col-md-6"><label class="form-label">Student</label><select asp-for="StudentId" class="form-select">@foreach(var s in ViewBag.Students){<option value="@s.Id">@s.FullName (@s.RollNumber)</option>}</select></div><div class="col-md-6"><label class="form-label">Subject</label><select asp-for="SubjectId" class="form-select">@foreach(var s in ViewBag.Subjects){<option value="@s.Id">@s.SubjectName</option>}</select></div><div class="col-md-6"><label asp-for="InternalMarks" class="form-label"></label><input asp-for="InternalMarks" class="form-control"/><span asp-validation-for="InternalMarks" class="text-danger"></span></div><div class="col-md-6"><label asp-for="ExternalMarks" class="form-label"></label><input asp-for="ExternalMarks" class="form-control"/><span asp-validation-for="ExternalMarks" class="text-danger"></span></div></div>
