@model IEnumerable<Mark>
@{ViewData["Title"]="Marks";}<div class="panel"><div class="d-flex justify-content-between mb-4"><p class="text-muted">Track internal and external performance.</p>@if(User.IsInRole("Admin")){<a class="btn btn-primary" asp-action="Create">+ Record marks</a>}</div><div class="table-responsive"><table class="table"><thead><tr><th>Student</th><th>Subject</th><th>Internal</th><th>External</th><th>Total</th><th>Grade</th>@if(User.IsInRole("Admin")){<th>Actions</th>}</tr></thead><tbody>@foreach(var m in Model){<tr><td>@m.Student?.FullName</td><td>@m.Subject?.SubjectName</td><td>@m.InternalMarks</td><td>@m.ExternalMarks</td><td><strong>@m.TotalMarks</strong></td><td><span class="badge-soft">@m.Grade</span></td>@if(User.IsInRole("Admin")){<td><a asp-action="Edit" asp-route-id="@m.Id">Edit</a> | <a asp-action="Delete" asp-route-id="@m.Id" class="text-danger">Delete</a></td>}</tr>}</tbody></table></div></div>
