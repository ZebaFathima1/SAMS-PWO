@model Attendance
<div class="row g-3 mb-4"><div class="col-md-6"><label class="form-label">Student</label><select asp-for="StudentId" class="form-select">@foreach(var s in ViewBag.Students){<option value="@s.Id">@s.FullName (@s.RollNumber)</option>}</select></div><div class="col-md-6"><label class="form-label">Subject</label><select asp-for="SubjectId" class="form-select">@foreach(var s in ViewBag.Subjects){<option value="@s.Id">@s.SubjectName</option>}</select></div><div class="col-md-6"><label asp-for="ConductedClasses" class="form-label"></label><input asp-for="ConductedClasses" class="form-control"/></div><div class="col-md-6"><label asp-for="AttendedClasses" class="form-label"></label><input asp-for="AttendedClasses" class="form-control"/><span asp-validation-for="AttendedClasses" class="text-danger"></span></div></div>
