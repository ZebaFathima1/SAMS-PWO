@model IEnumerable<Subject>
@{ViewData["Title"]="Subjects";}<div class="panel"><div class="d-flex justify-content-between mb-4"><p class="text-muted">Manage the academic curriculum.</p><a class="btn btn-primary" asp-action="Create">+ Add subject</a></div><form class="input-group mb-3"><input name="search" value="@ViewBag.Search" class="form-control" placeholder="Search code or subject name"/><button class="btn btn-outline-primary">Search</button></form><div class="table-responsive"><table class="table"><thead><tr><th>Code</th><th>Subject</th><th>Credits</th><th>Semester</th><th>Actions</th></tr></thead><tbody>@foreach(var s in Model){<tr><td><strong>@s.SubjectCode</strong></td><td>@s.SubjectName</td><td>@s.Credits</td><td>@s.Semester</td><td><a asp-action="Edit" asp-route-id="@s.Id" class="btn btn-sm btn-outline-primary">Edit</a> <a asp-action="Delete" asp-route-id="@s.Id" class="btn btn-sm btn-outline-danger">Delete</a></td></tr>}</tbody></table></div></div>
